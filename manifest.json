{
  "manifest_version": 3,
  "name": "Cookie Manager Dev",
  "version": "1.0.0",
  "description": "Pengelola cookie untuk developer pada environment website dan testing yang diizinkan.",
  "permissions": [
    "cookies",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Cookie Manager Dev"
  },
  "options_page": "settings.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
